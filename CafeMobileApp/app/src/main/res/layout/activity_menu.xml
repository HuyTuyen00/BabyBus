<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="#f8fafc">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#ffffff"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btnBackMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#0f172a" />

        <TextView
            android:id="@+id/tvMenuTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Bàn 1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0f172a" />

        <ImageButton
            android:id="@+id/btnToggleSearchProduct"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_search"
            app:tint="#0f172a" />
    </LinearLayout>

    <!-- Split View: Left (Products) + Right (Cart) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- LEFT PANEL: Product browsing -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#f8fafc">

            <!-- Search Input Bar -->
            <FrameLayout
                android:id="@+id/layoutProductSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingTop="8dp"
                android:visibility="visible">

                <EditText
                    android:id="@+id/edtSearchProduct"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_search_input"
                    android:hint="Tìm kiếm sản phẩm..."
                    android:textColor="#0f172a"
                    android:textColorHint="#94a3b8"
                    android:paddingHorizontal="14dp"
                    android:textSize="13sp"
                    android:inputType="text"
                    android:maxLines="1" />
            </FrameLayout>

            <!-- Category Filter Chips -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Product List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProducts"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingHorizontal="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:clipToPadding="false" />
        </LinearLayout>

        <!-- Vertical Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#e2e8f0" />

        <!-- RIGHT PANEL: Cart -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.95"
            android:orientation="vertical"
            android:background="#ffffff">

            <!-- Cart Header with badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingHorizontal="10dp"
                android:gravity="center_vertical"
                android:background="#f1f5f9">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Giỏ hàng"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0f172a" />

                <TextView
                    android:id="@+id/tvCartBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:minWidth="22dp"
                    android:gravity="center"
                    android:text="0"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:background="@drawable/bg_button_blue"
                    android:paddingHorizontal="6dp" />
            </LinearLayout>

            <!-- Cart Items RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCartItems"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingHorizontal="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:clipToPadding="false" />

            <!-- Cart Footer: Total + Submit Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#ffffff"
                android:elevation="4dp"
                android:padding="10dp">

                <!-- Total Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tổng tiền:"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#0f172a" />

                    <TextView
                        android:id="@+id/tvCartTotalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 đ"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#2563eb" />
                </LinearLayout>

                <!-- Submit Button -->
                <Button
                    android:id="@+id/btnSubmitOrder"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:backgroundTint="#2563eb"
                    android:text="🔔 BÁO BẾP"
                    android:textColor="#ffffff"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:ellipsize="none" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
