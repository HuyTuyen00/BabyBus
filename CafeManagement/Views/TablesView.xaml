<UserControl x:Class="CafeManagement.Views.TablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Table Grid -->
        <Grid Grid.Column="0" Margin="20,20,10,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Sơ đồ bàn" FontSize="20" FontWeight="ExtraBold"
                           Foreground="#f1f5f9" VerticalAlignment="Center"/>
                <Button x:Name="btnRefresh" Content="↻ Làm mới" HorizontalAlignment="Right"
                        Style="{StaticResource ModernButton}" Padding="14,6"
                        Click="BtnRefresh_Click"/>
            </Grid>

            <!-- Scrollable Table Grid -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="panelTables" Orientation="Horizontal"/>
            </ScrollViewer>
        </Grid>

        <!-- RIGHT: Management Panel -->
        <Border Grid.Column="1" Background="#1e293b" Margin="0,20,20,20"
                CornerRadius="12" Padding="18">
            <StackPanel>
                <TextBlock Text="Quản lý bàn" FontSize="16" FontWeight="ExtraBold"
                           Foreground="#38bdf8" Margin="0,0,0,20"/>

                <!-- Add Table -->
                <TextBlock Text="Thêm bàn mới" FontSize="13" Foreground="#94a3b8" Margin="0,0,0,6"/>
                <TextBox x:Name="txtNewTableName" Height="36" FontSize="13"
                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,8"
                         Tag="Tên bàn (VD: Bàn 7, VIP...)"
                         GotFocus="TxtNewTableName_GotFocus"
                         LostFocus="TxtNewTableName_LostFocus"
                         Text="Tên bàn (VD: Bàn 7, VIP...)"
                         Foreground="Gray"/>
                <Button x:Name="btnAddTable" Content="+ Thêm bàn"
                        Style="{StaticResource ModernButton}"
                        Background="#38bdf8" Foreground="#0f172a"
                        FontWeight="Bold" Height="36" Margin="0,0,0,24"
                        Click="BtnAddTable_Click"/>

                <!-- Separator -->
                <Separator Background="#334155" Margin="0,0,0,20"/>

                <!-- Free / Delete Table -->
                <TextBlock Text="Thao tác bàn đã chọn" FontSize="13" Foreground="#94a3b8" Margin="0,0,0,6"/>
                <TextBlock x:Name="lblSelectedTable" Text="(Chưa chọn bàn nào)"
                           FontSize="13" FontWeight="Bold" Foreground="#f1f5f9"
                           Margin="0,0,0,12" TextWrapping="Wrap"/>

                <Button x:Name="btnFreeTable" Content="✓ Dọn bàn / Bàn trống"
                        Style="{StaticResource ModernButton}"
                        Background="#10b981" Height="36" Margin="0,0,0,8"
                        IsEnabled="False"
                        Click="BtnFreeTable_Click"/>
                <Button x:Name="btnDeleteTable" Content="🗑 Xóa bàn này"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource DangerBrush}" Height="36"
                        IsEnabled="False"
                        Click="BtnDeleteTable_Click"/>

                <!-- Legend -->
                <Separator Background="#334155" Margin="0,24,0,16"/>
                <TextBlock Text="Chú thích" FontSize="12" Foreground="#64748b" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Width="16" Height="16" CornerRadius="3" Background="#1e3a5f" Margin="0,0,8,0"/>
                    <TextBlock Text="Trống" FontSize="12" Foreground="#94a3b8" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" CornerRadius="3" Background="#7f1d1d" Margin="0,0,8,0"/>
                    <TextBlock Text="Đang có khách" FontSize="12" Foreground="#94a3b8" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
