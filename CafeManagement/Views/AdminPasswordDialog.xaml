<Window x:Class="CafeManagement.Views.AdminPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xác thực Quản lý (Admin)"
        Height="280" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="White"
            BorderBrush="#e2e8f0"
            BorderThickness="1.5"
            CornerRadius="14"
            Padding="24"
            Effect="{DynamicResource ShadowEffect}">
        <Border.Resources>
            <DropShadowEffect x:Key="ShadowEffect" BlurRadius="20" ShadowDepth="4" Opacity="0.18" Color="#0f172a"/>
        </Border.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with Lock Icon -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                <Border Background="#fee2e2" Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0">
                    <TextBlock Text="🔒" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Yêu cầu Mật khẩu Quản lý" FontSize="16" FontWeight="Bold" Foreground="#0f172a"/>
                    <TextBlock Text="Thao tác này yêu cầu quyền quản trị cao nhất" FontSize="11.5" Foreground="#64748b"/>
                </StackPanel>
            </StackPanel>

            <!-- Action Description -->
            <TextBlock x:Name="txtActionDescription"
                       Grid.Row="1"
                       Text="Vui lòng nhập mật khẩu để tiếp tục:"
                       FontSize="13"
                       Foreground="#334155"
                       Margin="0,0,0,12"
                       TextWrapping="Wrap"/>

            <!-- Password Input + Error Warning -->
            <StackPanel Grid.Row="2">
                <PasswordBox x:Name="txtPassword"
                             Height="42"
                             FontSize="15"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             KeyDown="TxtPassword_KeyDown"
                             BorderBrush="#cbd5e1"
                             BorderThickness="1.5"
                             Background="#f8fafc"/>

                <TextBlock x:Name="txtError"
                           Text="❌ Mật khẩu không đúng! Vui lòng thử lại."
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#ef4444"
                           Margin="0,6,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- Buttons -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnCancel"
                        Grid.Column="0"
                        Content="Hủy bỏ"
                        Height="40"
                        FontSize="13.5"
                        FontWeight="SemiBold"
                        Background="#f1f5f9"
                        Foreground="#475569"
                        BorderThickness="0"
                        Click="BtnCancel_Click"/>

                <Button x:Name="btnConfirm"
                        Grid.Column="2"
                        Content="Xác nhận"
                        Height="40"
                        FontSize="13.5"
                        FontWeight="Bold"
                        Background="#2563eb"
                        Foreground="White"
                        BorderThickness="0"
                        Click="BtnConfirm_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
