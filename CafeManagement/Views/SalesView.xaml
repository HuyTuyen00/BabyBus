<UserControl x:Class="CafeManagement.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CafeManagement.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Custom Tab Style (KiotViet Pill Tab style) -->
        <Style x:Key="SalesTabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" CornerRadius="18" Padding="18,8" BorderThickness="0" Background="#e2e8f0" Cursor="Hand">
                            <TextBlock x:Name="textBlock" Text="{TemplateBinding Content}" FontWeight="Bold" FontSize="13.5" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="textBlock" Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#cbd5e1"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dedicated Style for Table Status Filters -->
        <Style x:Key="TableFilterRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" CornerRadius="14" Padding="12,5" BorderThickness="0" Background="#f1f5f9" Cursor="Hand" VerticalAlignment="Center">
                            <TextBlock x:Name="textBlock" Text="{TemplateBinding Content}" FontWeight="Bold" FontSize="12" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="textBlock" Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#cbd5e1"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Side: Dynamic Tables/Product Menu Switcher -->
            <ColumnDefinition Width="3*"/>
            <!-- Right Side: Invoice & Cart -->
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE: DYNAMIC MENU / TABLES GRID -->
        <Grid Grid.Column="0" Margin="15">
            <Grid.RowDefinitions>
                <!-- Tabs Selector -->
                <RowDefinition Height="Auto"/>
                <!-- Tab Panel Contents -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tabs selector -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="tabTables" 
                             Grid.Column="0" 
                             GroupName="SalesTabs"
                             IsChecked="True"
                             Style="{StaticResource SalesTabRadioButtonStyle}"
                             Content="🏢 Phòng bàn"
                             Checked="TabTables_Checked"/>
                <RadioButton x:Name="tabMenu" 
                             Grid.Column="1" 
                             GroupName="SalesTabs"
                             Style="{StaticResource SalesTabRadioButtonStyle}"
                             Content="🍕 Thực đơn"
                             Checked="TabMenu_Checked"
                             Margin="10,0,0,0"/>
            </Grid>

            <!-- TAB 1: TABLES GRID PANEL -->
            <Grid x:Name="gridTablesPanel" Grid.Row="1" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table Search Box -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtTableSearch" 
                             Style="{StaticResource ModernTextBox}" 
                             Tag="Tìm kiếm bàn (F2)..." 
                             GotFocus="TxtTableSearch_GotFocus" 
                             LostFocus="TxtTableSearch_LostFocus" 
                             Foreground="Gray"
                             Text="Tìm kiếm bàn (F2)..."
                             TextChanged="TxtTableSearch_TextChanged"
                             KeyDown="TxtTableSearch_KeyDown"
                             Height="40"/>
                    <Button Grid.Column="1" 
                             Content="Tìm" 
                             Style="{StaticResource ModernButton}" 
                             Margin="10,0,0,0" 
                             Width="80" 
                             Click="BtnTableSearch_Click"/>
                </Grid>

                <!-- Table Status Filters -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,15">
                    <RadioButton x:Name="radTableFilterAll" 
                                 GroupName="TableStatusFilters"
                                 Content="Toàn bộ" 
                                 IsChecked="True" 
                                 Style="{StaticResource TableFilterRadioButtonStyle}" 
                                 Checked="RadTableFilter_Checked"/>
                    <RadioButton x:Name="radTableFilterOccupied" 
                                 GroupName="TableStatusFilters"
                                 Content="Đang dùng" 
                                 Style="{StaticResource TableFilterRadioButtonStyle}" 
                                 Checked="RadTableFilter_Checked" 
                                 Margin="8,0,0,0"/>
                    <RadioButton x:Name="radTableFilterEmpty" 
                                 GroupName="TableStatusFilters"
                                 Content="Bàn trống" 
                                 Style="{StaticResource TableFilterRadioButtonStyle}" 
                                 Checked="RadTableFilter_Checked" 
                                 Margin="8,0,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="itemsTablesGrid">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="8" Width="140" Height="110" Cursor="Hand" Click="BtnTableCard_Click" Tag="{Binding Id}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="8" BorderThickness="1.5" Padding="10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                                                <Setter Property="Background" Value="#eff6ff"/>
                                                                <Setter Property="BorderBrush" Value="#3b82f6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsOccupied}" Value="False">
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="BorderBrush" Value="#cbd5e1"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPrinted}" Value="True">
                                                                <Setter Property="Background" Value="#fef08a"/>
                                                                <Setter Property="BorderBrush" Value="#ca8a04"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    
                                                    <!-- Top Row: Elapsed Time (Left) + Status (Right) -->
                                                    <Grid Grid.Row="0">
                                                        <TextBlock Text="{Binding ElapsedText}" 
                                                                   FontSize="10.5" 
                                                                   FontWeight="Bold" 
                                                                   Foreground="#0369a1" 
                                                                   HorizontalAlignment="Left" 
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Ellipse Width="7" Height="7" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                                                                <Setter Property="Fill" Value="#ef4444"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsOccupied}" Value="False">
                                                                                <Setter Property="Fill" Value="#94a3b8"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsPrinted}" Value="True">
                                                                                <Setter Property="Fill" Value="#ca8a04"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                                                                <Setter Property="Text" Value="Có khách"/>
                                                                                <Setter Property="Foreground" Value="#ef4444"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsOccupied}" Value="False">
                                                                                <Setter Property="Text" Value="Bàn trống"/>
                                                                                <Setter Property="Foreground" Value="#94a3b8"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsPrinted}" Value="True">
                                                                                <Setter Property="Text" Value="Đã in bill"/>
                                                                                <Setter Property="Foreground" Value="#ca8a04"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                    
                                                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#1e293b" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    
                                                    <TextBlock Grid.Row="2" Text="{Binding TotalAmount, StringFormat='{}{0:N0}đ'}" FontSize="12.5" FontWeight="ExtraBold" Foreground="#1d4ed8" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsOccupied}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#2563eb"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- TAB 2: PRODUCTS MENU PANEL -->
            <Grid x:Name="gridMenuPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <!-- Search bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Categories list -->
                    <RowDefinition Height="Auto"/>
                    <!-- Products Wrap Grid -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search bar -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtSearch" 
                             Style="{StaticResource ModernTextBox}" 
                             Tag="Tìm kiếm món (F3)..." 
                             GotFocus="TxtSearch_GotFocus" 
                             LostFocus="TxtSearch_LostFocus" 
                             Foreground="Gray"
                             Text="Tìm kiếm món (F3)..."
                             TextChanged="TxtSearch_TextChanged"
                             KeyDown="TxtSearch_KeyDown"
                             Height="40"/>
                    <Button Grid.Column="1" 
                             Content="Tìm" 
                             Style="{StaticResource ModernButton}" 
                             Margin="10,0,0,0" 
                             Width="80" 
                             Click="BtnSearch_Click"/>
                </Grid>

                <!-- Categories horizontal scroll -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,15">
                    <StackPanel x:Name="panelCategories" Orientation="Horizontal">
                        <!-- Category buttons will be dynamically added here -->
                    </StackPanel>
                </ScrollViewer>

                <!-- Products Wrap Grid Scroll -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="itemsProducts">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="6" Width="135" Height="125" Background="White" BorderThickness="1" BorderBrush="#e2e8f0" Cursor="Hand" Click="BtnProductCard_Click" Tag="{Binding Id}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Padding="8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="55"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" CornerRadius="4" ClipToBounds="True" Background="#f1f5f9" Margin="0,0,0,4">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Name[0]}" FontWeight="Bold" FontSize="18" Foreground="#94a3b8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image Source="{Binding ImageSource}" Stretch="UniformToFill"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontWeight="Bold" FontSize="11" Foreground="#1e293b" Height="30"/>
                                                        <Grid Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding Unit}" FontSize="10" Foreground="#64748b" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Price, StringFormat='{}{0:N0}đ'}" FontWeight="ExtraBold" FontSize="11" Foreground="#10b981" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#f1f5f9"/>
                                                    <Setter Property="BorderBrush" Value="#cbd5e1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- RIGHT SIDE: CART & BILLING -->
        <Border Grid.Column="1" Background="White" BorderThickness="1,0,0,0" BorderBrush="#e2e8f0">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <!-- Cart Item Grid -->
                    <RowDefinition Height="*"/>
                    <!-- Summary & Payment -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cart Items Grid with preparation status background color triggers -->
                <DataGrid x:Name="gridCart" Grid.Row="0" Margin="0,0,0,15" VerticalScrollBarVisibility="Auto" SelectionMode="Single"
                          CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#ffffff"/>
                            <Setter Property="Foreground" Value="#0f172a"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding KitchenStatus}" Value="Draft">
                                    <Setter Property="Background" Value="#ffffff"/>
                                    <Setter Property="Foreground" Value="#0f172a"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding KitchenStatus}" Value="Pending">
                                    <Setter Property="Background" Value="#ffffff"/>
                                    <Setter Property="Foreground" Value="#0f172a"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding KitchenStatus}" Value="Cooking">
                                    <Setter Property="Background" Value="#ffffff"/>
                                    <Setter Property="Foreground" Value="#0f172a"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding KitchenStatus}" Value="Processing">
                                    <Setter Property="Background" Value="#ffffff"/>
                                    <Setter Property="Foreground" Value="#0f172a"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding KitchenStatus}" Value="Completed">
                                    <Setter Property="Background" Value="#dcfce7"/>
                                    <Setter Property="Foreground" Value="#065f46"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding KitchenStatus}" Value="Served">
                                    <Setter Property="Background" Value="#fee2e2"/>
                                    <Setter Property="Foreground" Value="#991b1b"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                    <Setter Property="Background" Value="#fee2e2"/>
                                    <Setter Property="Foreground" Value="#991b1b"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <!-- Column 1: Product Name & Note -->
                        <DataGridTemplateColumn Header="Tên món" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="8,6,5,6">
                                        <!-- Product Name -->
                                        <TextBlock Text="{Binding ProductName}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="12.5" 
                                                   Foreground="#1e293b" 
                                                   TextWrapping="Wrap"/>
                                        
                                        <!-- Note TextBox (KiotViet Style) -->
                                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontSize="11" 
                                                 Foreground="#475569" 
                                                 Background="#f8fafc" 
                                                 BorderThickness="1" 
                                                 BorderBrush="#e2e8f0"
                                                 Margin="0,4,0,0" 
                                                 Padding="5,2"
                                                 Height="24"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="TxtCartNote_TextChanged"
                                                 PreviewMouseLeftButtonDown="TxtCartNote_PreviewMouseLeftButtonDown">
                                            <TextBox.Resources>
                                                <!-- VisualBrush to show a beautiful italic hint "Ghi chú..." when textbox is empty -->
                                                <VisualBrush x:Key="HintBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Ghi chú..." Foreground="#94a3b8" FontSize="11" FontStyle="Italic" Margin="5,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </TextBox.Resources>
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="IsEnabled" Value="True"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="Text" Value="{x:Null}">
                                                            <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter Property="BorderBrush" Value="#3b82f6"/>
                                                            <Setter Property="Background" Value="White"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column 2: Quantity buttons -->
                        <DataGridTemplateColumn Header="Số lượng" Width="1.1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                        <Button Content="-" Width="22" Height="22" Style="{StaticResource ModernButton}" Padding="0" Background="#e2e8f0" Foreground="Black" Click="BtnDecreaseQty_Click" Tag="{Binding ProductId}"/>
                                        <TextBlock Text="{Binding Quantity}" Width="25" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12.5" Foreground="#1e293b"/>
                                        <Button Content="+" Width="22" Height="22" Style="{StaticResource ModernButton}" Padding="0" Background="#e2e8f0" Foreground="Black" Click="BtnIncreaseQty_Click" Tag="{Binding ProductId}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column 3: Total Price -->
                        <DataGridTextColumn Header="Thành tiền" Binding="{Binding TotalPrice, StringFormat='{}{0:N0}'}" Width="1.1*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="#1e293b"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Column 4: Quick Delete Icon (Red X) -->
                        <DataGridTemplateColumn Header="" Width="0.45*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" 
                                            Height="24" 
                                            Width="24" 
                                            FontSize="13" 
                                            FontWeight="Bold"
                                            Background="#fee2e2" 
                                            Foreground="#ef4444"
                                            BorderThickness="1"
                                            BorderBrush="#fca5a5"
                                            Cursor="Hand"
                                            Click="BtnRemoveCartItem_Click" 
                                            Tag="{Binding ProductId}"
                                            VerticalAlignment="Center" 
                                            HorizontalAlignment="Center"
                                            ToolTip="Xóa món">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Billing Summary & Checkout buttons -->
                <Border Grid.Row="1" Background="#f8fafc" Padding="15" Margin="-15,0,-15,-15">
                    <StackPanel>
                        <!-- Table selector -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="☕ Bàn:" Grid.Column="0" FontSize="14" FontWeight="Bold"
                                       Foreground="#1e293b" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="cmbTable" Grid.Column="1" Height="34" FontSize="13"
                                      SelectionChanged="CmbTable_SelectionChanged"/>
                        </Grid>

                        <!-- Total Payable Amount -->
                        <Grid Margin="0,5,0,15">
                            <TextBlock Text="Tổng thanh toán:" FontSize="16" FontWeight="Bold" Foreground="#1e293b" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblPayable" HorizontalAlignment="Right" Text="0 đ" FontSize="22" FontWeight="ExtraBold" Foreground="#10b981"/>
                        </Grid>

                        <!-- Split buttons: Notify Kitchen (Báo bếp), Temp Print (In tạm tính), and Checkout (Thanh toán) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button x:Name="btnNotify" 
                                    Content="Thông báo (F8)" 
                                    Style="{StaticResource ModernButton}" 
                                    Background="#f59e0b" 
                                    Height="45" 
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Margin="0,0,4,0"
                                    Click="BtnNotify_Click"/>

                            <Button x:Name="btnTempPrint" 
                                    Grid.Column="1"
                                    Content="Tạm tính (F7)" 
                                    Style="{StaticResource ModernButton}" 
                                    Background="#0ea5e9" 
                                    Height="45" 
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Margin="4,0,4,0"
                                    Click="BtnTempPrint_Click"/>
                            
                            <Button x:Name="btnPay" 
                                    Grid.Column="2"
                                    Content="Thanh toán (F9)" 
                                    Style="{StaticResource ModernButton}" 
