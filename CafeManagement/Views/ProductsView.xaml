<UserControl x:Class="CafeManagement.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CafeManagement.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="{StaticResource BackgroundBrush}">
    
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <!-- Left Side: Add/Edit Product Form -->
            <ColumnDefinition Width="300"/>
            <!-- Right Side: Product List and Search -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE: ADD/EDIT FORM -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#e2e8f0" Padding="15" Margin="0,0,15,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="lblFormTitle" Text="THÊM SẢN PHẨM MỚI" FontSize="16" FontWeight="Bold" Foreground="#1e293b" Margin="0,0,0,15"/>
                    
                    <!-- Hidden ID field -->
                    <TextBlock x:Name="lblProductId" Visibility="Collapsed"/>

                    <!-- Product Name -->
                    <TextBlock Text="Tên sản phẩm *" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtName" Style="{StaticResource ModernTextBox}" Height="34" Margin="0,0,0,12"/>

                    <!-- Category -->
                    <TextBlock Text="Nhóm sản phẩm *" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cbFormCategory" Height="34" Margin="0,0,0,12" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                    <!-- Price -->
                    <TextBlock Text="Giá bán *" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtPrice" Style="{StaticResource ModernTextBox}" Height="34" Margin="0,0,0,12" Text="0"/>



                    <!-- Image Selection -->
                    <TextBlock Text="Hình ảnh sản phẩm" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtImagePath" Style="{StaticResource ModernTextBox}" Height="34" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="Chọn..." Style="{StaticResource ModernButton}" Background="#cbd5e1" Foreground="#1e293b" Height="34" Margin="6,0,0,0" Click="BtnChooseImage_Click"/>
                    </Grid>

                    <!-- Unit -->
                    <TextBlock Text="Đơn vị tính *" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtUnit" Style="{StaticResource ModernTextBox}" Height="34" Margin="0,0,0,12" Text="Ly"/>

                    <!-- Exclude from kitchen setting -->
                    <CheckBox x:Name="chkIsExcludeFromKitchen" Content="Không hiển thị vào bếp (không báo bếp)" FontWeight="SemiBold" Foreground="#475569" Margin="0,5,0,15" VerticalAlignment="Center"/>

                    <!-- Action Buttons -->
                    <Button x:Name="btnSave" Content="Lưu (Thêm)" Style="{StaticResource ModernButton}" Background="{StaticResource SuccessBrush}" Height="38" Margin="0,0,0,8" Click="BtnSave_Click"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnReset" Grid.Column="0" Content="Hủy/Xóa trắng" Style="{StaticResource ModernButton}" Background="#cbd5e1" Foreground="#1e293b" Height="36" Margin="0,0,4,0" Click="BtnReset_Click"/>
                        <Button x:Name="btnDelete" Grid.Column="1" Content="Xóa SP" Style="{StaticResource ModernButton}" Background="{StaticResource DangerBrush}" Height="36" Margin="4,0,0,0" IsEnabled="False" Click="BtnDelete_Click"/>
                    </Grid>

                    <!-- Category Management Sub-form -->
                    <Border BorderThickness="0,1,0,0" BorderBrush="#cbd5e1" Margin="0,15,0,15" Padding="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="QUẢN LÝ NHÓM SẢN PHẨM" FontSize="14" FontWeight="Bold" Foreground="#1e293b" Margin="0,0,0,10"/>

                            <!-- Add category -->
                            <TextBlock Text="Tên nhóm mới *" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtNewCategoryName" Style="{StaticResource ModernTextBox}" Height="34"/>
                                <Button x:Name="btnAddCategory" Grid.Column="1" Content="+ Thêm" Style="{StaticResource ModernButton}" Background="{StaticResource PrimaryBrush}" Height="34" Margin="6,0,0,0" Click="BtnAddCategory_Click"/>
                            </Grid>

                            <!-- Delete category -->
                            <TextBlock Text="Xóa nhóm" FontWeight="SemiBold" Foreground="#475569" Margin="0,8,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cbDeleteCategory" Height="34" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                <Button x:Name="btnDeleteCategory" Grid.Column="1" Content="Xóa" Style="{StaticResource ModernButton}" Background="{StaticResource DangerBrush}" Height="34" Margin="6,0,0,0" Click="BtnDeleteCategory_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- RIGHT SIDE: PRODUCT GRID & FILTERS -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Search & Excel Export -->
                <RowDefinition Height="Auto"/>
                <!-- Product Grid -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Filters -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Search -->
                <TextBox x:Name="txtSearchGrid" Grid.Column="0" Style="{StaticResource ModernTextBox}" Tag="Tìm theo tên sản phẩm..." GotFocus="TxtSearchGrid_GotFocus" LostFocus="TxtSearchGrid_LostFocus" Foreground="Gray" Text="Tìm theo tên sản phẩm..." TextChanged="TxtSearchGrid_TextChanged" Height="36" Margin="0,0,10,0"/>
                
                <!-- Category Filter -->
                <ComboBox x:Name="cbGridCategory" Grid.Column="1" Height="36" Margin="0,0,10,0" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CbGridCategory_SelectionChanged"/>

                <!-- Excel Import -->
                <Button Grid.Column="2" Content="Nhập Excel" Style="{StaticResource ModernButton}" Background="{StaticResource WarningBrush}" Height="36" Margin="0,0,8,0" Click="BtnImportExcel_Click"/>

                <!-- Excel Export -->
                <Button Grid.Column="3" Content="Xuất Excel" Style="{StaticResource ModernButton}" Background="{StaticResource PrimaryBrush}" Height="36" Click="BtnExportExcel_Click"/>
            </Grid>

            <!-- DataGrid -->
            <DataGrid x:Name="gridProducts" Grid.Row="1" VerticalScrollBarVisibility="Auto" SelectionChanged="GridProducts_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="0.6*" IsReadOnly="True" HeaderStyle="{StaticResource HeaderCenter}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Name}" Width="2*" IsReadOnly="True" HeaderStyle="{StaticResource HeaderLeft}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8,0,0,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Đơn giá" Binding="{Binding Price, StringFormat='{}{0:N0}'}" Width="1*" IsReadOnly="True" HeaderStyle="{StaticResource HeaderRight}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="0,0,12,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Đơn vị tính" Binding="{Binding Unit}" Width="0.8*" IsReadOnly="True" HeaderStyle="{StaticResource HeaderCenter}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Nhóm hàng" Binding="{Binding CategoryName}" Width="1.2*" IsReadOnly="True" HeaderStyle="{StaticResource HeaderLeft}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8,0,0,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridCheckBoxColumn Header="Không báo bếp" Binding="{Binding IsExcludeFromKitchen}" Width="1.1*" IsReadOnly="True" HeaderStyle="{StaticResource HeaderCenter}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
