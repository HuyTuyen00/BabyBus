<UserControl x:Class="CafeManagement.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CafeManagement.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">
             
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="CÀI ĐẶT HỆ THỐNG" FontSize="20" FontWeight="Bold" Foreground="#1e293b"/>
            <TextBlock Text="Cấu hình thiết bị máy in, kết nối máy chủ SQL Server và bảo mật dữ liệu" FontSize="12.5" Foreground="#64748b" Margin="0,4,0,0"/>
            <Separator Height="1" Background="#cbd5e1" Margin="0,15,0,0"/>
        </StackPanel>

        <!-- 2-Column Responsive Layout -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="1100" HorizontalAlignment="Left" Margin="0,0,10,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="460"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*" MinWidth="460"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: Printers & Security -->
                <StackPanel Grid.Column="0">
                    
                    <!-- 1. Printer & Copies Settings Card -->
                    <Border Background="White" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="🖨️ Cấu hình Máy In &amp; Bản In" FontSize="15" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,4"/>
                            <TextBlock Text="Chọn máy in nhiệt cho thu ngân, bếp và số lượng bản in tự động" FontSize="12" Foreground="#64748b" Margin="0,0,0,15"/>

                            <!-- Printer Selection -->
                            <TextBlock Text="Máy in Hóa đơn (Thu ngân):" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cmbPrinters" Height="38" FontSize="13.5" Padding="10,0" Margin="0,0,0,12"/>

                            <!-- Kitchen Printer Selection -->
                            <TextBlock Text="Máy in Bếp (Chế biến):" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cmbKitchenPrinters" Height="38" FontSize="13.5" Padding="10,0" Margin="0,0,0,14"/>

                            <Separator Height="1" Background="#f1f5f9" Margin="0,0,0,14"/>

                            <!-- Copies Settings -->
                            <TextBlock Text="Số lượng bản in tự động:" FontSize="13" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10"/>
                            
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bản in Tạm tính (F7):" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtTempCopies" Grid.Column="1" Height="34" FontSize="13.5" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bản in Thanh toán (F9):" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtPaidCopies" Grid.Column="1" Height="34" FontSize="13.5" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bản in Bếp chế biến:" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtKitchenCopies" Grid.Column="1" Height="34" FontSize="13.5" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center"/>
                            </Grid>

                            <!-- Save Printer Settings Button -->
                            <Button x:Name="btnSave" 
                                    Content="💾 Lưu Cấu hình Máy In" 
                                    Height="40" 
                                    Padding="20,0" 
                                    FontSize="13.5" 
                                    FontWeight="Bold" 
                                    Background="{StaticResource SuccessBrush}" 
                                    Foreground="White" 
                                    HorizontalAlignment="Left"
                                    Click="BtnSave_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Admin Security Password Card -->
                    <Border Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="🔒 Đổi Mật khẩu Quản lý (Admin Password)" FontSize="15" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,4"/>
                            <TextBlock Text="Mật khẩu bảo vệ các thao tác quan trọng (Xóa hóa đơn, Khởi tạo lại CSDL)." FontSize="12" Foreground="#64748b" Margin="0,0,0,14" TextWrapping="Wrap"/>
                            
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Old Password -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mật khẩu hiện tại (cũ):" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                                    <PasswordBox x:Name="txtOldAdminPassword" Height="36" FontSize="13.5" Padding="8,0" VerticalContentAlignment="Center" Background="White" BorderBrush="#cbd5e1" BorderThickness="1.5"/>
                                </StackPanel>

                                <!-- New Password -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Mật khẩu mới:" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                                    <PasswordBox x:Name="txtNewAdminPassword" Height="36" FontSize="13.5" Padding="8,0" VerticalContentAlignment="Center" Background="White" BorderBrush="#cbd5e1" BorderThickness="1.5"/>
                                </StackPanel>
                            </Grid>

                            <!-- Submit Button -->
                            <Button x:Name="btnUpdateAdminPassword" 
                                    Content="🔑 Đổi Mật khẩu Quản lý" 
                                    Height="38" 
                                    Padding="18,0" 
                                    FontSize="13" 
                                    FontWeight="Bold" 
                                    Background="#0284c7" 
                                    Foreground="White" 
                                    HorizontalAlignment="Left"
                                    Click="BtnUpdateAdminPassword_Click"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- RIGHT COLUMN: Database & Factory Reset -->
                <StackPanel Grid.Column="2">

                    <!-- 3. SQL Server Connection Settings Card -->
                    <Border Background="White" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="🗄️ Kết nối CSDL SQL Server (Mạng LAN / Wi-Fi)" FontSize="15" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,4"/>
                            <TextBlock Text="Cấu hình để Máy phụ (Laptop thu ngân) kết nối dùng chung dữ liệu với Máy chủ" FontSize="12" Foreground="#64748b" Margin="0,0,0,12"/>

                            <!-- Current Machine IP Banner -->
                            <Border Background="#f0f9ff" BorderBrush="#bae6fd" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="💡 IP Máy này (trong mạng Wi-Fi):" FontSize="11.5" FontWeight="SemiBold" Foreground="#0369a1"/>
                                        <TextBlock x:Name="txtCurrentMachineIp" Text="Đang lấy IP..." FontSize="13" FontWeight="Bold" Foreground="#0284c7" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="btnCopyIp" Grid.Column="1" Content="📋 Sao chép IP" Height="30" Padding="10,0" FontSize="11.5" FontWeight="SemiBold" Click="BtnCopyIp_Click"/>
                                </Grid>
                            </Border>

                            <!-- Server Host/IP -->
                            <TextBlock Text="Địa chỉ Máy chủ SQL (Server / IP):" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtSqlServer" Height="36" FontSize="13" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                            <!-- Database Name -->
                            <TextBlock Text="Tên Cơ sở dữ liệu (Database Name):" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtSqlDatabase" Text="CafeManagement" Height="36" FontSize="13" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,12,12"/>

                            <!-- Authentication Type -->
                            <TextBlock Text="Phương thức xác thực SQL:" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="rbWindowsAuth" Content="Windows Authentication" IsChecked="True" FontSize="12.5" Foreground="#334155" Margin="0,0,15,0" Checked="AuthMode_Changed" Unchecked="AuthMode_Changed"/>
                                <RadioButton x:Name="rbSqlAuth" Content="Tài khoản SQL (sa)" FontSize="12.5" Foreground="#334155" Checked="AuthMode_Changed" Unchecked="AuthMode_Changed"/>
                            </StackPanel>

                            <!-- SQL User & Password Panel -->
                            <StackPanel x:Name="panelSqlAuth" Visibility="Collapsed" Margin="0,0,0,12">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Tên đăng nhập:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtSqlUser" Text="sa" Height="34" FontSize="13" Padding="8,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Mật khẩu:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <PasswordBox x:Name="txtSqlPassword" Height="34" FontSize="13" Padding="8,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Live Status Banner -->
                            <TextBlock x:Name="txtSqlStatus" Text="" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" Visibility="Collapsed"/>

                            <!-- Test Connection & Save SQL Buttons -->
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnTestSqlConn" Content="🔌 Kiểm tra kết nối" Height="36" Padding="14,0" FontSize="12.5" FontWeight="Bold" Margin="0,0,10,0" Click="BtnTestSqlConn_Click"/>
                                <Button x:Name="btnSaveSqlConn" Content="💾 Lưu cấu hình SQL" Height="36" Padding="14,0" FontSize="12.5" FontWeight="Bold" Background="#0284c7" Foreground="White" Click="BtnSaveSqlConn_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 4. Database Reset / Factory Reset Card -->
                    <Border Background="#fef2f2" BorderBrush="#fecaca" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="⚠️ Khởi tạo lại Dữ liệu Gốc (Reset Database)" FontSize="15" FontWeight="Bold" Foreground="#991b1b" Margin="0,0,0,4"/>
                            <TextBlock Text="• Yêu cầu mật khẩu quản lý để thực hiện.&#10;• Xóa sạch toàn bộ hóa đơn thử nghiệm và làm mới 30 Bàn trống.&#10;• Tự động nạp lại Thực đơn mới chuẩn từ file Excel." FontSize="12" Foreground="#7f1d1d" Margin="0,0,0,14" TextWrapping="Wrap"/>
                            <Button x:Name="btnResetDb" 
                                    Content="🔄 Khởi tạo lại CSDL sạch sẽ" 
                                    Height="38" 
                                    Padding="18,0" 
                                    FontSize="13" 
                                    FontWeight="Bold" 
                                    Background="#ef4444" 
                                    Foreground="White" 
                                    HorizontalAlignment="Left" 
                                    Click="BtnResetDb_Click"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
